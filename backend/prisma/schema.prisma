datasource db {
  provider = "postgresql"
  extensions = [postgis, postgis_topology, postgis_tiger_geocoder, fuzzystrmatch]
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat   = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

model Event {
  id            String   @id @default(uuid())
  externalId    String?
  source        String
  title         String
  description   String?
  dateStart     DateTime
  dateEnd       DateTime
  coverUrl      String?
  addressName   String?
  addressStreet String?
  zipCode       String?
  city          String?
  latitude      Float?
  longitude     Float?
  location      Unsupported("geography(Point, 4326)")?
  priceType     String?
  priceDetail   String?
  accessLink    String?
  category      String[] @default([])
  audience      String?
  rank          Float?
  weight        Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([source, externalId])
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String?
}
