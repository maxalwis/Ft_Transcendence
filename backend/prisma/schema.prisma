datasource db {
  provider   = "postgresql"
  extensions = [postgis, postgis_topology, postgis_tiger_geocoder, fuzzystrmatch]
}

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  previewFeatures        = ["postgresqlExtensions"]
}

model Event {
  id            String   @id @default(uuid())
  externalId    String?
  source        String
  title         String
  description   String?
  dateStart     DateTime
  dateEnd       DateTime
  coverUrl      String?
  addressName   String?
  addressStreet String?
  zipCode       String?
  city          String?
  latitude      Float?
  longitude     Float?
  location      Unsupported("geography(Point, 4326)")?
  priceType     String?
  priceDetail   String?
  accessLink    String?
  category      String[] @default([])
  audience      String?
  rank          Float?
  weight        Int?
  messages      Message[]
  translations  TranslationCache[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([source, externalId])
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum UserStatus {
  OFFLINE
  ONLINE
}

enum PreferredCategory {
  MUSIC
  CULTURE
  WORKSHOPS
  LEISURE
  OTHERS
}

enum PreferredLanguage {
  FR
  EN
  ES
  AR
}

model User {
  id          Int        @id @default(autoincrement())
  username    String     @unique
  email       String     @unique
  password    String?    // nullable pour OAuth
  provider    String?    // OAuth
  providerId  String?    // OAuth
  avatar      String?
  status      UserStatus @default(OFFLINE)
  preferredLanguage PreferredLanguage @default(FR)
  preferredCategory PreferredCategory?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  messages            Message[]
  sentFriendships     Friendship[] @relation("SentFriendships")
  receivedFriendships Friendship[] @relation("ReceivedFriendships")
  @@unique([provider, providerId])
}

model Friendship {
  id        Int              @id @default(autoincrement())
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  senderId   Int
  sender     User @relation("SentFriendships", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId Int
  receiver   User @relation("ReceivedFriendships", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model TranslationCache {
  id             Int      @id @default(autoincrement())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lang           String   @db.VarChar(5)   // 'en', 'es', ...
  field          String   @db.VarChar(50)  // 'description', 'title', ...
  translatedText String
  createdAt      DateTime @default(now())

  @@unique([eventId, lang, field])
  @@index([eventId])
}
