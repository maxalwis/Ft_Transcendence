# cp .env.example .env
# Every "change_me" / "your_*" value must be replaced. Generate secrets with:
#   openssl rand -base64 48   (JWT secrets, API key, admin/elastic passwords)
#   openssl rand -hex 24      (POSTGRES_PASSWORD: it goes into DATABASE_URL, avoid URL special chars)


# ---- Host-published ports ------------------------------------
HTTPS_PORT=8443        # nginx: single entry point -> https://localhost:8443
POSTGRES_PORT=5432    # direct DB access (SQL tools)
REDIS_PORT=6379       # direct Redis access (debug) + worker's internal port
BACKEND_PORT=3000     # direct backend access (debug, bypassing the proxy)
STUDIO_PORT=5555      # Prisma Studio
FRONTEND_URL=https://localhost:${HTTPS_PORT} # seule origine CORS autorisée (HTTP + WebSocket), obligatoire

# ---- PostgreSQL ----------------------------------------------
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transcendence

# ---- Connection URL for the backend + prisma-studio ----------
# Port is the internal Docker one (always 5432), not POSTGRES_PORT
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ---- Redis (host resolved by the worker) ---------------------
REDIS_HOST=redis

# ---- JWT variables -------------------------------------------
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too

# ---- Public API ----------------------------------------------
PUBLIC_API_KEY=change_me

# ---- Google OAuth ---------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://localhost:${HTTPS_PORT}/api/auth/google/callback

# ---- 42 OAuth ---------------------
FORTYTWO_CLIENT_ID=u-s4t2ud-your_42_uid
FORTYTWO_CLIENT_SECRET=your_42_client_secret
FORTYTWO_CALLBACK_URL=https://localhost:${HTTPS_PORT}/api/auth/42/callback

# ---- LibreTranslate (traduction à la demande) -----------------
LIBRETRANSLATE_URL=http://libretranslate:5000

# ---- Enable seed logs -----------------------------------------
ENABLE_SEED_LOGS=false

# ---- Mail (real emails sent through Gmail SMTP) ----------------
# MAIL_PASS is a 16-char Google App Password (requires 2-Step Verification
# on the account), NOT the Gmail account password. Never commit it.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your_address@gmail.com
MAIL_PASS=your_16_char_app_password
MAIL_FROM=your_address@gmail.com

# ---- Public base URL of the app (used in emails, delete link) ----
APP_URL=https://localhost:${HTTPS_PORT}

# ---- Jawg Maps (map tiles) ------------------------------------
JAWG_TOKEN=your_jawg_token

# ---- Nginx basic auth for admin tools (Prisma Studio, Kibana) --
ADMIN_AUTH_USER=admin
ADMIN_AUTH_PASSWORD=change_me

# ---- Elasticsearch security (xpack) - used by the elk/tools profiles ----
# elastic: superuser, log into Kibana (:8445) and Elasticsearch (:8447) with it
ELASTIC_PASSWORD=change_me
# internal service accounts, set up by elasticsearch/scripts/setup.sh
KIBANA_SYSTEM_PASSWORD=change_me
LOGSTASH_INTERNAL_PASSWORD=change_me
