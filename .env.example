# cp .env.example .env


# ---- Host-published ports ------------------------------------
HTTPS_PORT=8443        # nginx: single entry point -> http://localhost:8443
POSTGRES_PORT=5432    # direct DB access (SQL tools)
REDIS_PORT=6379       # direct Redis access (debug) + worker's internal port
BACKEND_PORT=3000     # direct backend access (debug, bypassing the proxy)
STUDIO_PORT=5555      # Prisma Studio
FRONTEND_URL=https://localhost:8443 # évite de hardcoder 'localhost' dans le code (utilisé pour websocket)

# ---- PostgreSQL ----------------------------------------------
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transcendence

# ---- Connection URL for the backend + prisma-studio ----------
DATABASE_URL=postgresql://transcendence:changeme@postgres:5432/transcendence?schema=public

# ---- Redis (host resolved by the worker) ---------------------
REDIS_HOST=redis

# ---- JWT variables -------------------------------------------
JWT_SECRET=secret-tres-secret
JWT_REFRESH_SECRET=secret-qui-rafraichit
JWT_EXPIRES_IN=3600s

# ---- Public API ----------------------------------------------
PUBLIC_API_KEY=change-me-to-a-long-random-string

# ---- Google OAuth ---------------------
GOOGLE_CLIENT_ID=961237793784-uv67jo27l9ql7bknb82orbbi89nn4q2h.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_URL=https://localhost:8443/api/auth/google/callback

# ---- 42 OAuth ---------------------
FORTYTWO_CLIENT_ID=u-s4t2ud-f1281e6d990e0575bc3bd5faa941f16d0a0dde3fa71ee92553dfee8c7ebacd4a
FORTYTWO_CLIENT_SECRET=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
FORTYTWO_CALLBACK_URL=https://localhost:8443/api/auth/42/callback

# ---- LibreTranslate (traduction à la demande) -----------------
LIBRETRANSLATE_URL=http://libretranslate:5000

# ---- Enable seed logs -----------------------------------------
ENABLE_SEED_LOGS=false